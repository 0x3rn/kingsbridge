{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kingsbridge",
	"compatibility_date": "2026-10-10",
	"assets": {
		"directory": "./out",
		"html_handling": "none",
		"not_found_handling": "404-page",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"main": "worker/index.mjs"
}
