{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"**",
			"!!**/node_modules",
			"!!**/.next",
			"!!**/out",
			"!!**/build",
			"!!**/coverage",
			"!!**/.reference",
			"!!**/tmp",
			"!**/next-env.d.ts",
			"!**/package-lock.json"
		]
	},
	"linter": {
		"enabled": true,
		"rules": { "preset": "recommended" },
		"domains": { "react": "recommended", "next": "recommended" }
	},
	"css": {
		"parser": { "tailwindDirectives": true }
	}
}
